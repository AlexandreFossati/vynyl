# Runtime environment: development | test | production
NODE_ENV=development

# Port the API (and the SPA it serves) listens on
PORT=3000

# SQLite database file
DATABASE_PATH=./data/app.db

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Requests allowed per client IP in each window, for the routes under /api
RATE_LIMIT_MAX=100

# Length of the rate limit window, in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# Number of reverse proxies to trust when reading X-Forwarded-For (0 ignores the header).
# Leave it at 0 unless the API runs behind a proxy you control: otherwise clients can spoof their IP.
TRUST_PROXY=0
